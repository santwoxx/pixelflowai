# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Configurações do Firebase adicionais (Opcional, se não estiver usando o config local)
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="pixelflow-ai.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="pixelflow-ai"
VITE_FIREBASE_STORAGE_BUCKET="pixelflow-ai.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789"
VITE_FIREBASE_APP_ID="1:1234:web:1234"

# Mercado Pago Gateway (Para faturamento de assinaturas/créditos)
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY="APP_USR-b3b34832-d8ea-4493-b87b-94514c669de6"
MERCADOPAGO_ACCESS_TOKEN="APP_USR-6849257751380021-052922-abd88e74338a975c52c9e547ae7ac7d3-3436965718"

# Arquitetura Split (Produção Vercel + Render)
NEXT_PUBLIC_API_URL="https://pixelflow-backend.onrender.com"
FRONTEND_URL="https://pixelflow-ai.vercel.app"

